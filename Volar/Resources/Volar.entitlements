<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  feature 002 (plan.md Technical Context: "Mac App Store distribution: App Sandbox ON, no
	  Accessibility-dependent paths"; research.md R3). This SUPERSEDES the prior revision of this
	  file, which deliberately left the sandbox OFF because HotkeyManager needed
	  NSEvent.addGlobalMonitorForEvents (Accessibility-gated, MAS-hostile). HotkeyManager
	  (Sources/Speech/HotkeyManager.swift) now uses Carbon RegisterEventHotKey, which needs no
	  Accessibility permission and is sandbox-legal, so that blocker is gone.

	  Minimal set only — six keys, nothing else (was five before calendar read-only access was
	  added). No temporary-exception entitlements, no Apple Events, no broader file access than
	  user-selected read-write + its bookmark counterpart.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound calls only: Supabase Edge Function proxy (Groq speech + future /parse route)
	     and WhisperKit's one-time model download. No inbound/listening capability requested. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- CRITICAL: without this the microphone silently stops working under App Sandbox even
	     though NSMicrophoneUsageDescription (Info.plist) is set — TCC never even prompts, capture
	     just fails. This is the one entitlement whose absence breaks the app's core function. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- NSOpenPanel-driven file access: the custom ambient background image picker today
	     (SettingsView.swift `chooseImage`), and the future "Connect Claude Code" ~/.claude
	     picker (Orchestrator, later phase). Read-only: Volar only reads the picked image/folder,
	     never writes back. Grants access only to files the user explicitly
	     picks via the panel — not arbitrary filesystem access. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>

	<!-- Lets security-scoped bookmarks created from those NSOpenPanel selections keep resolving
	     across relaunches (see SecureImageBookmark in AmbientBackground.swift). Without this,
	     picked-file access is revoked the moment the app quits and every bookmark resolve would
	     fail on next launch. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- CRITICAL, same failure mode as com.apple.security.device.audio-input above: under App
	     Sandbox this entitlement is mandatory or the TCC prompt never appears and EventKit calls
	     (CalendarAccess.swift's `requestFullAccessToEvents`/`authorizationStatus`) silently fail —
	     the request just resolves to "denied"-equivalent with no prompt ever shown, and there is
	     no error message pointing back at the missing entitlement. NSCalendarsFullAccessUsage-
	     Description / NSCalendarsUsageDescription (Info.plist) alone are not sufficient without
	     this. Read-only in practice (see CalendarAccess.swift's header for why the grant is
	     nominally "full" access even though nothing in this app writes). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
